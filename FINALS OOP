            <button class="primary" style="width:100%">

                Confirm Order ✓

            </button>

        </form>

    `);

}

function placeOrder(event){

    event.preventDefault();

    const subtotal=cart.reduce((sum,item)=>{

        const product=products.find(p=>p.id===item.id);

        return sum+product.price*item.qty;

    },0);

    for(const item of cart){

        const product=products.find(p=>p.id===item.id);

        if(!product || product.stock<item.qty){

            toast("Insufficient product stock!");

            return;

        }

    }

    let shipping=subtotal>=1500?0:80;

    const delivery=document.getElementById("deliveryMethod").value;

    if(delivery==="Express Delivery"){
        shipping+=50;
    }

    const discount=voucher==="WISH10"?subtotal*.10:0;

    const order={

        id:"WS"+Date.now().toString().slice(-7),

        date:new Date().toLocaleString(),

        items:cart.map(item=>({...item})),

        subtotal:subtotal,

        shipping:shipping,

        discount:discount,

        total:subtotal+shipping-discount,

        status:"Order Placed",

        customer:document.getElementById("customerName").value,

        phone:document.getElementById("customerPhone").value,

        email:document.getElementById("customerEmail").value,

        address:document.getElementById("customerAddress").value,

        payment:document.getElementById("paymentMethod").value,

        delivery:delivery

    };

    cart.forEach(item=>{

        const product=products.find(p=>p.id===item.id);

        product.stock-=item.qty;

    });

    profile={

        name:order.customer,

        phone:order.phone,

        email:order.email,

        address:order.address

    };

    orders.unshift(order);

    cart=[];

    voucher="";

    saveData();

    localStorage.setItem("ws_stock",
        JSON.stringify(products.map(p=>({id:p.id,stock:p.stock}))
    ));

    showModal("🎉 ORDER SUCCESSFUL!",`

        <div class="empty">

            <h1 style="font-size:65px">🎉</h1>

            <h2>Thank You For Your Order!</h2>

            <br>

            <p>Order Number:</p>

            <h3>${order.id}</h3>

            <br>

            <p>Total Amount:</p>

            <h2 class="price">${money(order.total)}</h2>

            <br>

            <span class="status">Order Placed</span>

            <br><br>

            <button class="primary"
                onclick="openOrders()">

                Track My Order

            </button>

        </div>

    `);

    renderProducts();

}

