/* =========================
   DATA STORAGE
========================= */

function getData(key, fallback) {

    try {
        const value = JSON.parse(localStorage.getItem(key));

        return value ?? fallback;

    } catch {
        return fallback;
    }

}

let cart = getData("ws_cart",[]);
let wishlist = getData("ws_wish",[]);
let orders = getData("ws_orders",[]);

let profile = getData("ws_profile",{
    name:"Guest Shopper",
    email:"",
    phone:"",
    address:""
});

let activeCategory = "All";
let voucher = "";

function saveData() {

    localStorage.setItem("ws_cart",JSON.stringify(cart));
    localStorage.setItem("ws_wish",JSON.stringify(wishlist));
    localStorage.setItem("ws_orders",JSON.stringify(orders));
    localStorage.setItem("ws_profile",JSON.stringify(profile));

    updateBadges();

}

function money(amount) {

    return "₱" + Number(amount).toLocaleString("en-PH",{
        minimumFractionDigits:2,
        maximumFractionDigits:2
    });

}

function updateBadges() {

    document.getElementById("cartCount").textContent =
    cart.reduce((sum,item)=>sum+item.qty,0);

    document.getElementById("wishCount").textContent =
    wishlist.length;

}

/* =========================
   TOAST
========================= */

function toast(message) {

    const element = document.getElementById("toast");

    element.textContent = message;

    element.classList.add("show");

    setTimeout(()=>{
        element.classList.remove("show");
    },2300);

}

/* =========================
   PRODUCT DISPLAY
========================= */

function renderProducts() {

    const search = document.getElementById("searchInput")
    .value.toLowerCase();

    let list = products.filter(product=>{

        const categoryMatch =
        activeCategory==="All" ||
        product.cat===activeCategory;

        const searchMatch =
        product.name.toLowerCase().includes(search);

        return categoryMatch && searchMatch;

    });

    const sort = document.getElementById("sortFilter").value;

    if(sort==="low")
        list.sort((a,b)=>a.price-b.price);

    if(sort==="high")
        list.sort((a,b)=>b.price-a.price);

    if(sort==="rating")
        list.sort((a,b)=>b.rating-a.rating);

    const grid = document.getElementById("productGrid");

    if(!list.length){

        grid.innerHTML=`
        <div class="empty" style="grid-column:1/-1">
            <h2>🔍 No Products Found</h2>
            <p>Try another search.</p>
        </div>`;

        return;

    }

    grid.innerHTML=list.map(product=>`

        <div class="product">

            <div class="product-image">

                <img
                    src="${product.image}"
                    alt="${product.name}"
                    loading="lazy"
                    onerror="this.src='https://placehold.co/600x400?text=Wishlist+Shop'">

                ${product.badge?
                    `<span class="sale">${product.badge}</span>`:""}

                <button class="favorite"
                    onclick="toggleWishlist(${product.id})">

                    ${wishlist.includes(product.id)?"♥":"♡"}

                </button>

            </div>

            <div class="product-info">

                <h3>${product.name}</h3>

                <div class="rating">
                    ★★★★★ ${product.rating}
                </div>

                <div class="price">

                    ${money(product.price)}

                    <span class="old-price">
                        ${money(product.old)}
                    </span>

                </div>

                <div class="stock">

                    ${product.stock>5?
                    "🟢 In Stock":
                    product.stock>0?
                    "🟠 Only "+product.stock+" left":
                    "🔴 Out of Stock"}

                </div>

                <div class="product-actions">

                    <button class="secondary"
                        onclick="addCart(${product.id})"
                        ${product.stock===0?"disabled":""}>

                        🛒 Add

                    </button>

                    <button class="primary"
                        onclick="viewProduct(${product.id})">

                        View

                    </button>

                </div>

            </div>

        </div>

