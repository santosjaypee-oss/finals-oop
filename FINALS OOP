<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Wishlist Shop | Premium Shopping</title>

<style>

/* =========================
   GLOBAL SETTINGS
========================= */

:root {
    --primary: #7048e8;
    --secondary: #a78bfa;
    --dark: #241b45;
    --background: #f5f4fa;
    --card: #ffffff;
    --text: #242238;
    --muted: #777;
    --border: #e9e6f2;
    --success: #16a36a;
    --danger: #ef476f;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: var(--background);
    color: var(--text);
    transition: .3s;
}

button {
    cursor: pointer;
    border: none;
    border-radius: 9px;
    padding: 11px 15px;
    font-weight: bold;
    transition: .2s;
}

button:hover {
    transform: translateY(-2px);
    opacity: .9;
}

.primary {
    background: var(--primary);
    color: white;
}

.secondary {
    background: #eee9ff;
    color: var(--primary);
}

.danger {
    background: #ffe8ee;
    color: var(--danger);
}

input, textarea, select {
    font-family: inherit;
}

/* =========================
   OPENING ANIMATION
========================= */

#intro {
    position: fixed;
    inset: 0;
    background: linear-gradient(135deg,#241b45,#7048e8,#a78bfa);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    color: white;
    z-index: 9999;
    animation: introFade 1s ease 2.8s forwards;
}

.intro-logo {
    font-size: 42px;
    font-weight: 900;
    animation: logoPop 1.2s ease infinite alternate;
}

.intro-icon {
    font-size: 65px;
    margin-bottom: 15px;
    animation: bounce 1s infinite alternate;
}

.intro-text {
    margin-top: 15px;
    letter-spacing: 4px;
    font-size: 12px;
}

.loader {
    width: 180px;
    height: 5px;
    background: #ffffff55;
    border-radius: 20px;
    margin-top: 30px;
    overflow: hidden;
}

.loader::after {
    content: "";
    display: block;
    height: 100%;
    width: 0;
    background: white;
    animation: loading 2.5s forwards;
}

@keyframes loading {
    to { width: 100%; }
}

@keyframes logoPop {
    from { transform: scale(.9); }
    to { transform: scale(1.08); }
}

@keyframes bounce {
    to { transform: translateY(-12px); }
}

@keyframes introFade {
    to {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
    }
}

/* =========================
   TOP BAR
========================= */

.topbar {
    background: var(--dark);
    color: white;
    text-align: center;
    padding: 11px;
    font-size: 13px;
}

/* =========================
   HEADER
========================= */

header {
    background: var(--card);
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 3px 15px #0001;
}

.header {
    max-width: 1250px;
    margin: auto;
    padding: 15px;
    display: flex;
    align-items: center;
    gap: 15px;
}

.logo {
    font-size: 23px;
    font-weight: 900;
    color: var(--primary);
    white-space: nowrap;
}

.logo span {
    color: #ff6695;
}

.search {
    display: flex;
    flex: 1;
}

.search input {
    width: 100%;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 9px 0 0 9px;
    outline: none;
    background: var(--background);
    color: var(--text);
}

.search button {
    background: var(--primary);
    color: white;
    border-radius: 0 9px 9px 0;
}

.header-actions {
    display: flex;
    gap: 7px;
}

.header-actions button {
    background: var(--background);
    color: var(--text);
    font-size: 16px;
}

.badge-count {
    background: var(--danger);
    color: white;
    padding: 2px 6px;
    border-radius: 20px;
    font-size: 10px;
}

/* =========================
   NAVIGATION
========================= */

.nav {
    display: flex;
    justify-content: center;
    gap: 25px;
    padding: 12px;
    border-top: 1px solid var(--border);
}

.nav button {
    background: transparent;
    color: var(--muted);
}

.nav button:hover {
    color: var(--primary);
}

/* =========================
   MAIN
========================= */

main {
    max-width: 1250px;
    margin: 25px auto;
    padding: 0 15px;
}

/* =========================
   HERO SECTION
========================= */

.hero {
    background: linear-gradient(120deg,#241b45,#7048e8,#a78bfa);
    color: white;
    padding: 55px;
    border-radius: 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    overflow: hidden;
    gap: 20px;
}

.hero h1 {
    font-size: clamp(30px,5vw,52px);
    margin: 18px 0;
}

.hero p {
    max-width: 550px;
    line-height: 1.7;
    margin-bottom: 25px;
}

.hero button {
    background: white;
    color: var(--primary);
    padding: 14px 22px;
}

.hero-icon {
    font-size: 130px;
    animation: float 3s infinite ease-in-out;
}

@keyframes float {
    50% { transform: translateY(-15px); }
}

/* =========================
   SECTIONS
========================= */

.section {
    margin: 35px 0;
}

.section-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
}

/* =========================
   CATEGORIES
========================= */

.categories {
    display: grid;
    grid-template-columns: repeat(6,1fr);
    gap: 12px;
}

.category {
    background: var(--card);
    color: var(--text);
    border: 1px solid var(--border);
    padding: 20px 8px;
}

.category span {
    display: block;
    font-size: 30px;
    margin-bottom: 10px;
}

.category.active {
    border: 2px solid var(--primary);
    color: var(--primary);
    background: #eee9ff;
}

/* =========================
   FLASH DEAL
========================= */

.deal {
    background: linear-gradient(120deg,#fff0f4,#ffe1ec);
    padding: 20px;
    border-radius: 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #b82c60;
}

#countdown {
    font-size: 25px;
    font-weight: bold;
}

/* =========================
   PRODUCT FILTERS
========================= */

.filters {
    display: flex;
    gap: 8px;
}

.filters select {
    padding: 10px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card);
    color: var(--text);
}

/* =========================
   PRODUCT GRID
========================= */

.products {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 20px;
}

.product {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    transition: .3s;
}

.product:hover {
    transform: translateY(-7px);
    box-shadow: 0 12px 30px #0002;
}

.product-image {
    height: 210px;
    background: #f0ecff;
    position: relative;
    overflow: hidden;
}

.product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: .4s;
}

.product:hover .product-image img {
    transform: scale(1.08);
}

.sale {
    position: absolute;
    top: 10px;
    left: 10px;
    background: var(--danger);
    color: white;
    padding: 6px 9px;
    border-radius: 5px;
    font-size: 10px;
}

.favorite {
    position: absolute;
    top: 10px;
    right: 10px;
    background: white;
    color: var(--danger);
    border-radius: 50%;
    font-size: 19px;
    padding: 8px 11px;
}

.product-info {
    padding: 15px;
}

.product-info h3 {
    font-size: 15px;
    min-height: 35px;
    margin-bottom: 8px;
}

.rating {
    color: #e6a21a;
    font-size: 13px;
    margin-bottom: 9px;
}

.price {
    color: var(--primary);
    font-size: 20px;
    font-weight: bold;
}

.old-price {
    color: #999;
    text-decoration: line-through;
    font-size: 12px;
}

.stock {
    color: var(--muted);
    font-size: 12px;
    margin: 10px 0;
}

.product-actions {
    display: flex;
    gap: 7px;
}

.product-actions button {
    flex: 1;
    font-size: 12px;
}

/* =========================
   FOOTER
========================= */

footer {
    background: var(--dark);
    color: white;
    padding: 40px 20px;
    text-align: center;
    margin-top: 60px;
}

footer h2 {
    color: #b99cff;
    margin-bottom: 10px;
}

footer p {
    margin: 8px;
}

/* =========================
   MODAL
========================= */

.modal-bg {
    display: none;
    position: fixed;
    inset: 0;
    background: #000a;
    z-index: 500;
    justify-content: center;
    align-items: center;
    padding: 15px;
}

.modal-bg.show {
    display: flex;
}

.modal {
    background: var(--card);
    color: var(--text);
    width: min(700px,100%);
    max-height: 90vh;
    overflow-y: auto;
    padding: 23px;
    border-radius: 17px;
    animation: modalPop .25s ease;
}

@keyframes modalPop {
    from {
        transform: scale(.9);
        opacity: 0;
    }
    to {
        transform: scale(1);
        opacity: 1;
    }
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.close {
    background: #eee;
    color: #333;
}

.cart-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 0;
    border-bottom: 1px solid var(--border);
}

.cart-row img {
    width: 65px;
    height: 65px;
    object-fit: cover;
    border-radius: 10px;
}

.cart-info {
    flex: 1;
}

.quantity {
    display: flex;
    align-items: center;
    gap: 8px;
}

.quantity button {
    background: #eee9ff;
    color: var(--primary);
    padding: 6px 10px;
}

.summary {
    background: var(--background);
    padding: 17px;
    border-radius: 12px;
    margin-top: 18px;
}

.summary div {
    display: flex;
    justify-content: space-between;
    margin: 10px 0;
}

.total {
    border-top: 1px solid var(--border);
    padding-top: 12px;
    font-size: 21px;
    font-weight: bold;
}

.field {
    margin: 14px 0;
}

.field label {
    display: block;
    margin-bottom: 7px;
    font-size: 13px;
    font-weight: bold;
}

.field input,
.field textarea,
.field select {
    width: 100%;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--background);
    color: var(--text);
}

.field textarea {
    resize: vertical;
    min-height: 80px;
}

.empty {
    text-align: center;
    padding: 35px 10px;
    color: var(--muted);
}

.order {
    border: 1px solid var(--border);
    padding: 15px;
    border-radius: 12px;
    margin: 12px 0;
}

.order p {
    margin: 8px 0;
    font-size: 13px;
}

.status {
    display: inline-block;
    background: #e6fff2;
    color: #148653;
    padding: 5px 9px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: bold;
}

.toast {
    position: fixed;
    bottom: 25px;
    left: 50%;
    transform: translate(-50%,100px);
    background: var(--dark);
    color: white;
    padding: 14px 22px;
    border-radius: 10px;
    z-index: 1000;
    transition: .3s;
}

.toast.show {
    transform: translate(-50%,0);
}

/* =========================
   DARK MODE
========================= */

.dark {
    --background: #151322;
    --card: #211e32;
    --text: #f1efff;
    --muted: #b6b2c9;
    --border: #37324d;
}

.dark .product-image {
    background: #302a48;
}

.dark .category.active {
    background: #392d5b;
}

.dark .close {
    background: #39344b;
    color: white;
}

.dark .deal {
    background: #392032;
    color: #ff9ab8;
}

/* =========================
   MOBILE RESPONSIVE
========================= */

@media(max-width:900px) {
    .products {
        grid-template-columns: repeat(3,1fr);
    }

    .categories {
        grid-template-columns: repeat(3,1fr);
    }
}

@media(max-width:600px) {

    .header {
        flex-wrap: wrap;
    }

    .logo {
        font-size: 19px;
    }

    .search {
        order: 3;
        flex-basis: 100%;
    }

    .header-actions {
        margin-left: auto;
    }

    .header-actions button {
        padding: 9px;
        font-size: 14px;
    }

    .nav {
        justify-content: flex-start;
        overflow-x: auto;
        gap: 12px;
    }

    .nav button {
        white-space: nowrap;
    }

    .hero {
        padding: 25px;
    }

    .hero-icon {
        font-size: 55px;
    }

    .products {
        grid-template-columns: repeat(2,1fr);
        gap: 10px;
    }

    .product-image {
        height: 140px;
    }

    .product-info {
        padding: 10px;
    }

    .product-info h3 {
        font-size: 13px;
    }

    .price {
        font-size: 16px;
    }

    .categories {
        gap: 7px;
    }

    .category {
        font-size: 12px;
        padding: 12px 5px;
    }

    .section-title {
        flex-wrap: wrap;
    }

    .deal {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
    }

    .filters {
        width: 100%;
    }

    .filters select {
        flex: 1;
        min-width: 0;
    }

    .cart-row {
        flex-wrap: wrap;
    }
}

</style>
</head>

