/* =========================
   SHOPPING CART
========================= */

function addCart(id){

    const product=products.find(p=>p.id===id);

    const item=cart.find(p=>p.id===id);

    if(!product || product.stock<=0){

        toast("Product is out of stock!");
        return;

    }

    if(item && item.qty>=product.stock){

        toast("Maximum available stock reached!");
        return;

    }

    if(item){
        item.qty++;
    }

    else{
        cart.push({id:id,qty:1});
    }

    saveData();

    toast("Product added to cart!");

}

function changeQuantity(id,amount){

    const item=cart.find(p=>p.id===id);

    const product=products.find(p=>p.id===id);

    if(!item || !product) return;

    item.qty=Math.max(1,Math.min(product.stock,item.qty+amount));

    saveData();
    openCart();

}

function removeCart(id){

    cart=cart.filter(item=>item.id!==id);

    saveData();
    openCart();

}

function openCart(){

    const items=cart.map(item=>({

        ...item,

        product:products.find(p=>p.id===item.id)

    })).filter(item=>item.product);

    const subtotal=items.reduce(
        (sum,item)=>sum+item.product.price*item.qty,0
    );

    const shipping=subtotal===0||subtotal>=1500?0:80;

    const discount=voucher==="WISH10"?subtotal*.10:0;

    const total=subtotal+shipping-discount;

    showModal("🛒 SHOPPING CART",items.length?`

        ${items.map(item=>`

            <div class="cart-row">

                <img src="${item.product.image}" alt="">

                <div class="cart-info">

                    <b>${item.product.name}</b>

                    <div class="price">
                        ${money(item.product.price)}
                    </div>

                </div>

                <div class="quantity">

                    <button onclick="changeQuantity(${item.id},-1)">−</button>

                    ${item.qty}

                    <button onclick="changeQuantity(${item.id},1)">+</button>

                </div>

                <button class="danger"
                    onclick="removeCart(${item.id})">

                    ✕

                </button>

            </div>

        `).join("")}

        <div class="field">

            <label>Voucher Code</label>

            <input id="voucherInput"
                placeholder="Enter WISH10"
                value="${voucher}">

            <button class="primary"
                style="margin-top:8px"
                onclick="applyVoucher()">

                Apply Voucher

            </button>

        </div>

        <div class="summary">

            <div>
                <span>Subtotal</span>
                <b>${money(subtotal)}</b>
            </div>

            <div>
                <span>Shipping</span>
                <b>${shipping===0?"FREE":money(shipping)}</b>
            </div>

            <div>
                <span>Discount</span>
                <b>-${money(discount)}</b>
            </div>

            <div class="total">
                <span>Total</span>
                <span>${money(total)}</span>
            </div>

            <button class="primary"
                style="width:100%;margin-top:15px"
                onclick="checkout()">

                Proceed to Checkout →

            </button>

        </div>

    `:`

        <div class="empty">

            <h1>🛒</h1>

            <h2>Your Cart is Empty</h2>

            <p>Start adding your favorite products!</p>

        </div>

    `);

}

function applyVoucher(){

    const code=document.getElementById("voucherInput")
    .value.trim().toUpperCase();

    if(code==="WISH10"){

        voucher=code;

        toast("10% discount applied!");

        openCart();

    }

    else{

        toast("Invalid voucher code!");

    }

}

