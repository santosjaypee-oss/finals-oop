    .reduce((sum,o)=>sum+o.total,0);

    showModal("🛠 ADMIN DASHBOARD",`

        <h3>📊 Store Overview</h3>

        <br>

        <div class="summary">

            <div>
                <span>Total Products</span>
                <b>${products.length}</b>
            </div>

            <div>
                <span>Total Orders</span>
                <b>${orders.length}</b>
            </div>

            <div>
                <span>Demo Sales</span>
                <b>${money(sales)}</b>
            </div>

            <div>
                <span>Active Orders</span>
                <b>${orders.filter(o=>o.status!=="Cancelled").length}</b>
            </div>

        </div>

        <br>

        <h3>📦 Inventory Management</h3>

        ${products.map(product=>`

            <div class="cart-row">

                <img src="${product.image}" alt="">

                <div class="cart-info">

                    <b>${product.name}</b>

                    <p>Stock: ${product.stock}</p>

                </div>

                <button class="secondary"
                    onclick="adjustStock(${product.id},-1)">

                    −

                </button>

                <button class="primary"
                    onclick="adjustStock(${product.id},1)">

                    +

                </button>

            </div>

        `).join("")}

        <br>

        <h3>📋 Manage Orders</h3>

        ${orders.map(order=>`

            <div class="order">

                <b>#${order.id}</b>

                <p>${order.customer}</p>

                <p>${money(order.total)}</p>

                <p>Status: ${order.status}</p>

                <select onchange="changeOrderStatus('${order.id}',this.value)">

                    <option ${order.status==="Order Placed"?"selected":""}>
                        Order Placed
                    </option>

                    <option ${order.status==="Processing"?"selected":""}>
                        Processing
                    </option>

                    <option ${order.status==="Shipped"?"selected":""}>
                        Shipped
                    </option>

                    <option ${order.status==="Delivered"?"selected":""}>
                        Delivered
                    </option>

                    <option ${order.status==="Cancelled"?"selected":""}>
                        Cancelled
                    </option>

                </select>

            </div>

        `).join("")}

        <br>

        <p style="font-size:12px;color:var(--muted)">
            Local demonstration dashboard.
            It is not protected by a real administrator login.
        </p>

    `);

}

function adjustStock(id,amount){

    const product=products.find(p=>p.id===id);

    if(!product)return;

    product.stock=Math.max(0,product.stock+amount);

    localStorage.setItem("ws_stock",
        JSON.stringify(products.map(p=>({id:p.id,stock:p.stock}))
    ));

    openAdmin();

    renderProducts();

}

function changeOrderStatus(id,status){

    const order=orders.find(o=>o.id===id);

    if(!order)return;

    order.status=status;

    saveData();

    toast("Order status updated!");

    openAdmin();

}

/* =========================
   MODAL
========================= */

function showModal(title,content){

    document.getElementById("modalTitle").textContent=title;

    document.getElementById("modalContent").innerHTML=content;

    document.getElementById("modalBg").classList.add("show");

}

function closeModal(){

    document.getElementById("modalBg").classList.remove("show");

}

document.getElementById("modalBg").addEventListener("click",function(e){

    if(e.target===this){
        closeModal();
    }

});

/* =========================
   DARK MODE
========================= */

function toggleDark(){

    document.body.classList.toggle("dark");

    localStorage.setItem(
        "ws_dark",
        document.body.classList.contains("dark")
    );

}

/* =========================
   FLASH SALE TIMER
========================= */

let seconds=5*60*60;

setInterval(()=>{

    seconds--;

    if(seconds<=0){
        seconds=5*60*60;
    }

    const h=String(Math.floor(seconds/3600)).padStart(2,"0");

    const m=String(Math.floor((seconds%3600)/60)).padStart(2,"0");

    const s=String(seconds%60).padStart(2,"0");

    document.getElementById("countdown").textContent=
        h+":"+m+":"+s;

},1000);

/* =========================
   INITIALIZE WEBSITE
========================= */

// Restore inventory

const savedStock=getData("ws_stock",[]);

savedStock.forEach(item=>{

    const product=products.find(p=>p.id===item.id);

    if(product){
        product.stock=item.stock;
    }

});

// Restore dark mode

if(localStorage.getItem("ws_dark")==="true"){

    document.body.classList.add("dark");

}

// Start website

updateBadges();

renderProducts();

</script>

